---
const projects = [
  {
    title: "E-Commerce Platform",
    description: "A full-stack e-commerce solution with modern UI, secure payments, and admin dashboard. Built with React, Node.js, and PostgreSQL.",
    image: "/api/placeholder/600/400",
    tags: ["React", "Node.js", "PostgreSQL", "Stripe"],
    github: "https://github.com/yourusername/ecommerce-platform",
    demo: "https://ecommerce-demo.netlify.app",
    featured: true
  },
  {
    title: "Task Management App",
    description: "Collaborative task management application with real-time updates, drag-and-drop functionality, and team collaboration features.",
    image: "/api/placeholder/600/400",
    tags: ["Vue.js", "Firebase", "Tailwind CSS"],
    github: "https://github.com/yourusername/task-manager",
    demo: "https://task-manager-demo.netlify.app",
    featured: true
  },
  {
    title: "Weather Dashboard",
    description: "Beautiful weather application with location-based forecasts, interactive maps, and customizable widgets.",
    image: "/api/placeholder/600/400",
    tags: ["JavaScript", "OpenWeather API", "Chart.js"],
    github: "https://github.com/yourusername/weather-dashboard",
    demo: "https://weather-dashboard-demo.netlify.app",
    featured: false
  },
  {
    title: "Portfolio Website",
    description: "Modern portfolio website built with Astro, featuring smooth animations and optimized performance.",
    image: "/api/placeholder/600/400",
    tags: ["Astro", "TypeScript", "Tailwind CSS"],
    github: "https://github.com/yourusername/portfolio",
    demo: "https://yourportfolio.com",
    featured: false
  },
  {
    title: "AI Chat Interface",
    description: "Intelligent chat interface with natural language processing and context-aware responses.",
    image: "/api/placeholder/600/400",
    tags: ["Python", "FastAPI", "OpenAI", "React"],
    github: "https://github.com/yourusername/ai-chat",
    demo: "https://ai-chat-demo.netlify.app",
    featured: true
  },
  {
    title: "Fitness Tracker",
    description: "Mobile-first fitness tracking application with workout plans, progress tracking, and social features.",
    image: "/api/placeholder/600/400",
    tags: ["React Native", "MongoDB", "Express"],
    github: "https://github.com/yourusername/fitness-tracker",
    demo: "https://fitness-tracker-demo.netlify.app",
    featured: false
  }
];

const featuredProjects = projects.filter(project => project.featured);
const otherProjects = projects.filter(project => !project.featured);
---

<section id="projects" class="py-20 lg:py-32 relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-gradient-to-br from-green-500/10 to-transparent rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-gradient-to-tl from-blue-500/10 to-transparent rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        Featured <span class="gradient-text">Projects</span>
      </h2>
      <p class="text-xl text-slate-400 max-w-2xl mx-auto">
        A showcase of my recent work and creative solutions
      </p>
      <div class="w-20 h-1 bg-gradient-to-r from-green-500 to-blue-500 mx-auto rounded-full mt-6"></div>
    </div>

    <!-- Featured Projects -->
    <div class="space-y-24 mb-20">
      {featuredProjects.map((project, index) => (
        <div class={`project-card grid lg:grid-cols-2 gap-12 items-center ${index % 2 !== 0 ? 'lg:grid-cols-2' : ''}`}>
          <!-- Project Image -->
          <div class={`relative group ${index % 2 !== 0 ? 'lg:order-2' : ''}`}>
            <div class="aspect-video rounded-2xl overflow-hidden gradient-border hover-glow transition-all duration-500 group-hover:scale-105">
              <!-- Placeholder for project image -->
              <div class="w-full h-full bg-gradient-to-br from-slate-800 to-slate-900 flex items-center justify-center">
                <div class="text-slate-600 text-center">
                  <svg class="w-20 h-20 mx-auto mb-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
                  </svg>
                  <p class="text-sm">Project Screenshot</p>
                </div>
              </div>
            </div>
            
            <!-- Floating elements -->
            <div class="absolute -top-4 -right-4 w-20 h-20 bg-blue-500/20 rounded-full blur-xl animate-pulse-glow"></div>
            <div class="absolute -bottom-6 -left-6 w-16 h-16 bg-green-500/20 rounded-full blur-xl animate-pulse-glow delay-100"></div>
          </div>

          <!-- Project Info -->
          <div class={`space-y-6 ${index % 2 !== 0 ? 'lg:order-1' : ''}`}>
            <div>
              <h3 class="text-3xl font-bold text-white mb-4">{project.title}</h3>
              <p class="text-slate-300 text-lg leading-relaxed">{project.description}</p>
            </div>

            <!-- Technologies -->
            <div class="flex flex-wrap gap-3">
              {project.tags.map(tag => (
                <span class="px-4 py-2 bg-slate-800/50 text-slate-300 rounded-full text-sm font-medium border border-slate-700 hover:border-blue-500 hover:text-blue-300 transition-colors">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Project Links -->
            <div class="flex gap-4">
              <a 
                href={project.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-green-600 to-blue-600 rounded-lg font-medium hover-glow transition-all duration-300 hover:scale-105"
              >
                <span>Live Demo</span>
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
              
              <a 
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center px-6 py-3 border-2 border-slate-600 rounded-lg font-medium hover:border-blue-400 hover:bg-blue-400/10 transition-all duration-300 hover:scale-105"
              >
                <span>View Code</span>
                <svg class="w-5 h-5 ml-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Other Projects -->
    <div class="text-center mb-12">
      <h3 class="text-3xl font-bold text-white mb-4">Other Projects</h3>
      <p class="text-slate-400">More projects I've worked on</p>
    </div>

    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">
      {otherProjects.map((project, index) => (
        <div class="project-card-small glass-effect rounded-2xl p-6 hover-glow group transition-all duration-500 hover:scale-105">
          <!-- Project Image -->
          <div class="aspect-video rounded-xl overflow-hidden mb-6 bg-gradient-to-br from-slate-800 to-slate-900">
            <div class="w-full h-full flex items-center justify-center">
              <div class="text-slate-600 text-center">
                <svg class="w-12 h-12 mx-auto mb-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
                </svg>
                <p class="text-xs">Screenshot</p>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <h4 class="text-xl font-bold text-white group-hover:gradient-text transition-all duration-300">{project.title}</h4>
            <p class="text-slate-400 text-sm leading-relaxed">{project.description}</p>
            
            <!-- Technologies -->
            <div class="flex flex-wrap gap-2">
              {project.tags.map(tag => (
                <span class="px-3 py-1 bg-slate-800/50 text-slate-400 rounded-full text-xs border border-slate-700">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Project Links -->
            <div class="flex gap-3 pt-2">
              <a 
                href={project.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 text-center py-2 bg-gradient-to-r from-green-600/80 to-blue-600/80 rounded-lg text-sm font-medium hover:from-green-600 hover:to-blue-600 transition-all duration-300"
              >
                Demo
              </a>
              
              <a 
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 text-center py-2 border border-slate-600 rounded-lg text-sm font-medium hover:border-blue-400 hover:bg-blue-400/10 transition-all duration-300"
              >
                Code
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-16">
      <p class="text-slate-400 mb-8">Want to see more of my work?</p>
      <a 
        href="https://github.com/yourusername" 
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 rounded-lg font-medium hover-glow transition-all duration-300 hover:scale-105"
      >
        <span>View All Projects on GitHub</span>
        <svg class="w-5 h-5 ml-3" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .project-card {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .project-card-small {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card-small.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Staggered animations */
  .project-card:nth-child(2) { transition-delay: 0.2s; }
  .project-card:nth-child(3) { transition-delay: 0.4s; }

  .project-card-small:nth-child(1) { transition-delay: 0.1s; }
  .project-card-small:nth-child(2) { transition-delay: 0.2s; }
  .project-card-small:nth-child(3) { transition-delay: 0.3s; }
</style>

<script>
  // Intersection Observer for project animations
  const projectsObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  });

  document.addEventListener('DOMContentLoaded', () => {
    // Observe project cards
    const projectCards = document.querySelectorAll('.project-card, .project-card-small');
    projectCards.forEach(card => {
      projectsObserver.observe(card);
    });
  });

  // Add parallax effect to floating elements
  window.addEventListener('scroll', () => {
    const scrolled = window.pageYOffset;
    const floatingElements = document.querySelectorAll('.absolute.w-20, .absolute.w-16');
    
    floatingElements.forEach((element, index) => {
      const speed = (index % 2 === 0) ? 0.3 : -0.3;
      const yPos = scrolled * speed;
      element.style.transform = `translateY(${yPos}px)`;
    });
  });
</script>
