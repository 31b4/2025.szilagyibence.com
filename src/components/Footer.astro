---
const { t } = Astro.props;
---
<footer class="relative z-40 bg-black border-t border-gray-800 py-8">
  <div class="container mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-center">
      <p class="text-gray-400 mb-4 md:mb-0">
        &copy; 2025 Bence Szilagyi.
      </p>
      <div class="flex items-center space-x-6">
        <a href="https://x.com/31b4_" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="text-gray-500 hover:text-white transition-colors">
          <i class="fa-brands fa-x-twitter text-xl"></i>
        </a>
        <a href="https://github.com/31b4" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-gray-500 hover:text-white transition-colors">
          <i class="fa-brands fa-github text-xl"></i>
        </a>
        <a href="https://linkedin.com/in/benszilagyi/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-gray-500 hover:text-white transition-colors">
          <i class="fa-brands fa-linkedin text-xl"></i>
        </a>
        <a href="https://instagram.com/szilagyix" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-gray-500 hover:text-white transition-colors">
          <i class="fa-brands fa-instagram text-xl"></i>
        </a>
        <a href="https://youtube.com/@ben31b4" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-gray-500 hover:text-white transition-colors">
          <i class="fa-brands fa-youtube text-xl"></i>
        </a>
        <a href="mailto:contact@szilagyibence.com" aria-label="Email" class="text-gray-500 hover:text-white transition-colors">
          <i class="fa-solid fa-envelope text-xl"></i>
        </a>
  <span class="text-gray-600">•</span>
  <div class="relative group">
    <button class="text-gray-400 hover:text-white transition-colors flex items-center gap-1">
      {t?.common?.resume ?? 'Resume'}
      <i class="fa-solid fa-chevron-down text-xs transition-transform group-hover:rotate-180"></i>
    </button>
    <div class="absolute bottom-full mb-2 left-1/2 transform -translate-x-1/2 bg-gray-800 border border-gray-600 rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50 min-w-max">
      <a href="/Resume - English.pdf" target="_blank" rel="noopener noreferrer"
         class="block px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-700 transition-colors rounded-t-lg whitespace-nowrap">
        <i class="fa-solid fa-file-pdf text-red-400 mr-2"></i>{t?.common?.resumeEnglish ?? 'English Resume'}
      </a>
      <a href="/Resume - Hungarian.pdf" target="_blank" rel="noopener noreferrer"
         class="block px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-700 transition-colors rounded-b-lg whitespace-nowrap">
        <i class="fa-solid fa-file-pdf text-red-400 mr-2"></i>{t?.common?.resumeHungarian ?? 'Hungarian Resume'}
      </a>
    </div>
  </div>
      </div>
    </div>
  </div>
</footer>
