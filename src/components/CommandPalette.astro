---
// Command Palette - Terminal-style navigation
---
<div id="command-palette" class="fixed inset-0 z-[9999] hidden">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" id="command-backdrop"></div>
  
  <!-- Command Palette Window -->
  <div class="relative z-10 flex items-start justify-center pt-[20vh] px-4">
    <div class="w-full max-w-2xl bg-gray-900 rounded-2xl shadow-2xl border border-gray-700 overflow-hidden transform transition-all">
      <!-- Terminal Header -->
      <div class="bg-gray-800 px-4 py-3 flex items-center gap-2 border-b border-gray-700">
        <div class="flex gap-2">
          <div class="w-3 h-3 rounded-full bg-red-500"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-full bg-green-500"></div>
        </div>
        <span class="text-gray-400 text-sm ml-2 font-mono">terminal@szilagyibence.com</span>
      </div>

      <!-- Input Area -->
      <div class="p-4 flex items-center gap-3 border-b border-gray-800">
        <span class="text-blue-400 font-mono text-lg">$</span>
        <input 
          type="text" 
          id="command-input"
          placeholder="Type a command..."
          class="flex-1 bg-transparent text-white text-lg outline-none font-mono placeholder-gray-600"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="px-2 py-1 bg-gray-800 text-gray-400 text-xs rounded border border-gray-700">ESC</kbd>
      </div>

      <!-- Suggestions/Results -->
      <div id="command-results" class="max-h-[50vh] overflow-y-auto p-2">
        <!-- Default commands shown -->
        <div class="command-list">
          <div class="command-item px-4 py-3 hover:bg-gray-800 rounded-lg cursor-pointer transition-colors group" data-command="/projects">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="text-2xl">🚀</span>
                <div>
                  <div class="text-white font-medium">/projects</div>
                  <div class="text-gray-500 text-sm">View my projects</div>
                </div>
              </div>
              <i class="fa-solid fa-arrow-right text-gray-600 group-hover:text-blue-400 transition-colors"></i>
            </div>
          </div>

          <div class="command-item px-4 py-3 hover:bg-gray-800 rounded-lg cursor-pointer transition-colors group" data-command="/skills">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="text-2xl">⚡</span>
                <div>
                  <div class="text-white font-medium">/skills</div>
                  <div class="text-gray-500 text-sm">What I can build</div>
                </div>
              </div>
              <i class="fa-solid fa-arrow-right text-gray-600 group-hover:text-blue-400 transition-colors"></i>
            </div>
          </div>

          <div class="command-item px-4 py-3 hover:bg-gray-800 rounded-lg cursor-pointer transition-colors group" data-command="/work">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="text-2xl">💼</span>
                <div>
                  <div class="text-white font-medium">/work</div>
                  <div class="text-gray-500 text-sm">Work experience</div>
                </div>
              </div>
              <i class="fa-solid fa-arrow-right text-gray-600 group-hover:text-blue-400 transition-colors"></i>
            </div>
          </div>

          <div class="command-item px-4 py-3 hover:bg-gray-800 rounded-lg cursor-pointer transition-colors group" data-command="/contact">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="text-2xl">📧</span>
                <div>
                  <div class="text-white font-medium">/contact</div>
                  <div class="text-gray-500 text-sm">Get in touch</div>
                </div>
              </div>
              <i class="fa-solid fa-arrow-right text-gray-600 group-hover:text-blue-400 transition-colors"></i>
            </div>
          </div>

          <div class="command-item px-4 py-3 hover:bg-gray-800 rounded-lg cursor-pointer transition-colors group" data-command="/now">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="text-2xl">⏰</span>
                <div>
                  <div class="text-white font-medium">/now</div>
                  <div class="text-gray-500 text-sm">What I'm doing now</div>
                </div>
              </div>
              <i class="fa-solid fa-arrow-right text-gray-600 group-hover:text-blue-400 transition-colors"></i>
            </div>
          </div>

          <div class="command-item px-4 py-3 hover:bg-gray-800 rounded-lg cursor-pointer transition-colors group" data-command="/github">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="text-2xl">
                  <i class="fa-brands fa-github text-white"></i>
                </span>
                <div>
                  <div class="text-white font-medium">/github</div>
                  <div class="text-gray-500 text-sm">Open GitHub profile</div>
                </div>
              </div>
              <i class="fa-solid fa-arrow-right text-gray-600 group-hover:text-blue-400 transition-colors"></i>
            </div>
          </div>

        </div>
      </div>

      <!-- Footer hint -->
      <div class="px-4 py-3 bg-gray-800/50 border-t border-gray-700 flex items-center justify-between text-xs text-gray-500">
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1">
            <kbd class="px-1.5 py-0.5 bg-gray-700 rounded text-gray-400">↑↓</kbd>
            navigate
          </span>
          <span class="flex items-center gap-1">
            <kbd class="px-1.5 py-0.5 bg-gray-700 rounded text-gray-400">↵</kbd>
            select
          </span>
        </div>
        <span>Press <kbd class="px-1.5 py-0.5 bg-gray-700 rounded text-gray-400">ESC</kbd> to close</span>
      </div>
    </div>
  </div>
</div>

<script>
  // Command Palette Logic
  const palette = document.getElementById('command-palette');
  const backdrop = document.getElementById('command-backdrop');
  const input = document.getElementById('command-input') as HTMLInputElement;
  const results = document.getElementById('command-results');
  let selectedIndex = 0;

  const commands: Record<string, () => void> = {
    '/projects': () => scrollToSection('projects'),
    '/skills': () => scrollToSection('skills'),
    '/work': () => scrollToSection('work-experience'),
    '/contact': () => scrollToSection('contact'),
    '/now': () => window.location.href = '/now',
    '/github': () => window.open('https://github.com/31b4', '_blank'),
  };

  function scrollToSection(id: string) {
    closePalette();
    const element = document.getElementById(id);
    if (element) {
      element.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      window.location.href = '/#' + id;
    }
  }

  function openPalette() {
    if (!palette) return;
    palette.classList.remove('hidden');
    setTimeout(() => input?.focus(), 100);
  }

  function closePalette() {
    if (!palette) return;
    palette.classList.add('hidden');
    if (input) input.value = '';
    selectedIndex = 0;
    updateSelection();
  }

  function updateSelection() {
    const items = document.querySelectorAll('.command-item');
    items.forEach((item, idx) => {
      if (idx === selectedIndex) {
        item.classList.add('bg-gray-800');
        item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      } else {
        item.classList.remove('bg-gray-800');
      }
    });
  }

  function filterCommands(query: string) {
    const items = document.querySelectorAll('.command-item');
    const normalizedQuery = query.toLowerCase().trim();
    
    items.forEach((item) => {
      const command = (item as HTMLElement).dataset.command?.toLowerCase() || '';
      const text = item.textContent?.toLowerCase() || '';
      
      if (command.includes(normalizedQuery) || text.includes(normalizedQuery)) {
        (item as HTMLElement).style.display = '';
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });
    
    selectedIndex = 0;
    updateSelection();
  }

  function executeCommand(command: string) {
    const handler = commands[command];
    if (handler) {
      handler();
    }
  }

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    // Cmd+K or Ctrl+K to open
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openPalette();
      return;
    }

    // Only handle these keys when palette is open
    if (!palette?.classList.contains('hidden')) {
      if (e.key === 'Escape') {
        e.preventDefault();
        closePalette();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        const items = Array.from(document.querySelectorAll('.command-item')).filter(
          (item) => (item as HTMLElement).style.display !== 'none'
        );
        selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
        updateSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        updateSelection();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const items = Array.from(document.querySelectorAll('.command-item')).filter(
          (item) => (item as HTMLElement).style.display !== 'none'
        );
        const selected = items[selectedIndex] as HTMLElement;
        if (selected) {
          const command = selected.dataset.command;
          if (command) executeCommand(command);
        }
      }
    }
  });

  // Input filtering
  input?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value;
    filterCommands(query);
  });

  // Click handlers
  backdrop?.addEventListener('click', closePalette);

  document.querySelectorAll('.command-item').forEach((item) => {
    item.addEventListener('click', () => {
      const command = (item as HTMLElement).dataset.command;
      if (command) executeCommand(command);
    });
  });

  // Initial selection
  updateSelection();
</script>

<style>
  #command-palette {
    animation: fadeIn 0.15s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .command-item {
    transition: all 0.15s ease;
  }

  #command-input::selection {
    background-color: rgba(59, 130, 246, 0.3);
  }

  /* Custom scrollbar for results */
  #command-results::-webkit-scrollbar {
    width: 8px;
  }

  #command-results::-webkit-scrollbar-track {
    background: transparent;
  }

  #command-results::-webkit-scrollbar-thumb {
    background: rgba(75, 85, 99, 0.5);
    border-radius: 4px;
  }

  #command-results::-webkit-scrollbar-thumb:hover {
    background: rgba(75, 85, 99, 0.8);
  }
</style>
