---
const skillCategories = [
  {
    title: "Frontend",
    icon: "🎨",
    skills: [
      { name: "React/Next.js", level: 90 },
      { name: "Vue/Nuxt", level: 85 },
      { name: "TypeScript", level: 88 },
      { name: "Tailwind CSS", level: 92 },
    ]
  },
  {
    title: "Backend",
    icon: "⚙️",
    skills: [
      { name: "Node.js", level: 87 },
      { name: "Python", level: 83 },
      { name: "PostgreSQL", level: 80 },
      { name: "MongoDB", level: 78 },
    ]
  },
  {
    title: "Tools & Others",
    icon: "🛠️",
    skills: [
      { name: "Git/GitHub", level: 90 },
      { name: "Docker", level: 75 },
      { name: "AWS", level: 70 },
      { name: "Figma", level: 85 },
    ]
  }
];
---

<section id="skills" class="py-20 lg:py-32 relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute top-1/2 left-0 w-96 h-96 bg-gradient-to-r from-cyan-500/10 to-transparent rounded-full blur-3xl"></div>
  <div class="absolute top-0 right-1/4 w-80 h-80 bg-gradient-to-bl from-pink-500/10 to-transparent rounded-full blur-3xl"></div>

  <div class="max-w-6xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        My <span class="gradient-text">Skills</span>
      </h2>
      <p class="text-xl text-slate-400 max-w-2xl mx-auto">
        Technologies and tools I use to bring ideas to life
      </p>
      <div class="w-20 h-1 bg-gradient-to-r from-cyan-500 to-pink-500 mx-auto rounded-full mt-6"></div>
    </div>

    <!-- Skills grid -->
    <div class="grid lg:grid-cols-3 gap-8 mb-16">
      {skillCategories.map((category, categoryIndex) => (
        <div class="glass-effect rounded-2xl p-8 hover-glow group transition-all duration-500">
          <div class="text-center mb-8">
            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform duration-300">
              {category.icon}
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">{category.title}</h3>
            <div class="w-12 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto rounded-full"></div>
          </div>
          
          <div class="space-y-6">
            {category.skills.map((skill, skillIndex) => (
              <div class="skill-item">
                <div class="flex justify-between items-center mb-2">
                  <span class="font-medium text-slate-200">{skill.name}</span>
                  <span class="text-sm text-slate-400 skill-percentage">{skill.level}%</span>
                </div>
                <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden">
                  <div 
                    class="skill-bar h-full bg-gradient-to-r from-blue-500 to-purple-500 rounded-full transition-all duration-1000 ease-out"
                    data-width={skill.level}
                    style="width: 0%"
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Technology icons/logos -->
    <div class="text-center">
      <h3 class="text-2xl font-bold text-white mb-8">Technologies I Work With</h3>
      <div class="grid grid-cols-3 md:grid-cols-6 lg:grid-cols-8 gap-6 max-w-4xl mx-auto">
        <div class="tech-icon group">
          <div class="w-16 h-16 bg-gradient-to-br from-blue-500/20 to-blue-600/30 rounded-xl flex items-center justify-center border border-blue-500/30 group-hover:border-blue-400 group-hover:bg-blue-500/30 transition-all duration-300">
            <span class="text-2xl">⚛️</span>
          </div>
          <p class="text-xs text-slate-400 mt-2">React</p>
        </div>
        
        <div class="tech-icon group">
          <div class="w-16 h-16 bg-gradient-to-br from-green-500/20 to-green-600/30 rounded-xl flex items-center justify-center border border-green-500/30 group-hover:border-green-400 group-hover:bg-green-500/30 transition-all duration-300">
            <span class="text-2xl">🟢</span>
          </div>
          <p class="text-xs text-slate-400 mt-2">Node.js</p>
        </div>
        
        <div class="tech-icon group">
          <div class="w-16 h-16 bg-gradient-to-br from-blue-500/20 to-blue-600/30 rounded-xl flex items-center justify-center border border-blue-500/30 group-hover:border-blue-400 group-hover:bg-blue-500/30 transition-all duration-300">
            <span class="text-2xl font-bold text-blue-400">TS</span>
          </div>
          <p class="text-xs text-slate-400 mt-2">TypeScript</p>
        </div>
        
        <div class="tech-icon group">
          <div class="w-16 h-16 bg-gradient-to-br from-cyan-500/20 to-cyan-600/30 rounded-xl flex items-center justify-center border border-cyan-500/30 group-hover:border-cyan-400 group-hover:bg-cyan-500/30 transition-all duration-300">
            <span class="text-2xl font-bold text-cyan-400">TW</span>
          </div>
          <p class="text-xs text-slate-400 mt-2">Tailwind</p>
        </div>
        
        <div class="tech-icon group">
          <div class="w-16 h-16 bg-gradient-to-br from-yellow-500/20 to-yellow-600/30 rounded-xl flex items-center justify-center border border-yellow-500/30 group-hover:border-yellow-400 group-hover:bg-yellow-500/30 transition-all duration-300">
            <span class="text-2xl">🐍</span>
          </div>
          <p class="text-xs text-slate-400 mt-2">Python</p>
        </div>
        
        <div class="tech-icon group">
          <div class="w-16 h-16 bg-gradient-to-br from-purple-500/20 to-purple-600/30 rounded-xl flex items-center justify-center border border-purple-500/30 group-hover:border-purple-400 group-hover:bg-purple-500/30 transition-all duration-300">
            <span class="text-2xl">🗄️</span>
          </div>
          <p class="text-xs text-slate-400 mt-2">PostgreSQL</p>
        </div>
        
        <div class="tech-icon group">
          <div class="w-16 h-16 bg-gradient-to-br from-orange-500/20 to-orange-600/30 rounded-xl flex items-center justify-center border border-orange-500/30 group-hover:border-orange-400 group-hover:bg-orange-500/30 transition-all duration-300">
            <span class="text-2xl">🐳</span>
          </div>
          <p class="text-xs text-slate-400 mt-2">Docker</p>
        </div>
        
        <div class="tech-icon group">
          <div class="w-16 h-16 bg-gradient-to-br from-red-500/20 to-red-600/30 rounded-xl flex items-center justify-center border border-red-500/30 group-hover:border-red-400 group-hover:bg-red-500/30 transition-all duration-300">
            <span class="text-2xl">🎨</span>
          </div>
          <p class="text-xs text-slate-400 mt-2">Figma</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tech-icon {
    @apply flex flex-col items-center opacity-70 hover:opacity-100 transition-all duration-300 cursor-pointer;
  }

  .tech-icon:hover {
    transform: translateY(-4px) scale(1.05);
  }

  .skill-bar {
    transform-origin: left;
  }

  @keyframes skill-fill {
    from {
      width: 0%;
    }
    to {
      width: var(--target-width);
    }
  }
</style>

<script>
  // Intersection Observer for skill bars animation
  const skillsObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        // Animate skill bars
        const skillBars = entry.target.querySelectorAll('.skill-bar');
        
        skillBars.forEach((bar, index) => {
          setTimeout(() => {
            const targetWidth = bar.getAttribute('data-width') + '%';
            bar.style.width = targetWidth;
            
            // Animate percentage counter
            const percentageElement = bar.closest('.skill-item').querySelector('.skill-percentage');
            const targetPercentage = parseInt(bar.getAttribute('data-width'));
            let currentPercentage = 0;
            
            const countAnimation = setInterval(() => {
              if (currentPercentage < targetPercentage) {
                currentPercentage++;
                percentageElement.textContent = currentPercentage + '%';
              } else {
                clearInterval(countAnimation);
              }
            }, 20);
            
          }, index * 200);
        });
        
        // Animate cards
        const cards = entry.target.querySelectorAll('.glass-effect');
        cards.forEach((card, index) => {
          setTimeout(() => {
            card.classList.add('animate-fade-in-up');
          }, index * 200);
        });
        
        // Animate tech icons
        const techIcons = entry.target.querySelectorAll('.tech-icon');
        techIcons.forEach((icon, index) => {
          setTimeout(() => {
            icon.classList.add('animate-fade-in-up');
          }, 600 + (index * 100));
        });
      }
    });
  }, {
    threshold: 0.2,
    rootMargin: '0px 0px -100px 0px'
  });

  document.addEventListener('DOMContentLoaded', () => {
    const skillsSection = document.getElementById('skills');
    if (skillsSection) {
      skillsObserver.observe(skillsSection);
    }
  });

  // Add hover effects to skill cards
  const skillCards = document.querySelectorAll('.glass-effect');
  skillCards.forEach(card => {
    card.addEventListener('mouseenter', () => {
      const skillBars = card.querySelectorAll('.skill-bar');
      skillBars.forEach(bar => {
        bar.style.transform = 'scaleY(1.2)';
      });
    });
    
    card.addEventListener('mouseleave', () => {
      const skillBars = card.querySelectorAll('.skill-bar');
      skillBars.forEach(bar => {
        bar.style.transform = 'scaleY(1)';
      });
    });
  });
</script>
