---
const { t } = Astro.props;
---
<section class="fixed inset-0 flex items-center justify-center z-0">
  <div class="container mx-auto px-6 text-center">
    <div class="space-y-8 animate-fade-in">
      <div class="inline-block">
        <div class="text-6xl md:text-8xl font-bold mb-4">
          <span class="text-white">Szilágyi</span>
        </div>
        <div class="h-1 bg-gradient-to-r from-blue-500 to-cyan-400 rounded animate-pulse"></div>
      </div>
      <p class="text-xl md:text-2xl text-gray-300 max-w-2xl mx-auto">
        {t?.hero?.tagline ?? 'Entrepreneur, developer and boxer with unlimited ambition.'}
      </p>
      
      <!-- Command Palette Hint -->
      <div class="mt-8 opacity-70 hover:opacity-100 transition-opacity">
        <p class="text-sm text-gray-500">
          Try pressing <kbd class="px-2 py-1 bg-gray-800/50 border border-gray-700 rounded text-gray-400 font-mono text-xs">Ctrl</kbd> + <kbd class="px-2 py-1 bg-gray-800/50 border border-gray-700 rounded text-gray-400 font-mono text-xs">K</kbd>
        </p>
      </div>
    </div>
  </div>
</section>
