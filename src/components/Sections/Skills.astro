---
const { t } = Astro.props;
---
<section id="skills" class="relative z-40 py-20 bg-black">
  <div class="container mx-auto px-6">
    <h2 class="text-4xl md:text-5xl font-bold text-center mb-16">
  <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-400">{t?.sections?.skills ?? 'What I Can Build'}</span>
    </h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="bg-gray-900/50 backdrop-blur-sm rounded-xl p-8 border border-gray-800 hover:border-blue-500/50 transition-all duration-300">
        <div class="text-4xl mb-4">🚀</div>
  <h3 class="text-2xl font-bold mb-6 text-white">{t?.skills?.mobile ?? 'Mobile Development'}</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-blue-600/20 text-blue-300 rounded-full text-sm border border-blue-500/30">iOS App Development</span>
          <span class="px-3 py-1 bg-blue-600/20 text-blue-300 rounded-full text-sm border border-blue-500/30">Android App Development</span>
          <span class="px-3 py-1 bg-blue-600/20 text-blue-300 rounded-full text-sm border border-blue-500/30">App Store Distribution</span>
          <span class="px-3 py-1 bg-blue-600/20 text-blue-300 rounded-full text-sm border border-blue-500/30">Cross-Platform Apps</span>
        </div>
      </div>

      <div class="bg-gray-900/50 backdrop-blur-sm rounded-xl p-8 border border-gray-800 hover:border-blue-500/50 transition-all duration-300">
        <div class="text-4xl mb-4">🌐</div>
  <h3 class="text-2xl font-bold mb-6 text-white">{t?.skills?.web ?? 'Web Development'}</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-blue-600/20 text-blue-300 rounded-full text-sm border border-blue-500/30">Full-Stack Web Apps</span>
          <span class="px-3 py-1 bg-blue-600/20 text-blue-300 rounded-full text-sm border border-blue-500/30">Database Design</span>
          <span class="px-3 py-1 bg-blue-600/20 text-blue-300 rounded-full text-sm border border-blue-500/30">API Development</span>
          <span class="px-3 py-1 bg-blue-600/20 text-blue-300 rounded-full text-sm border border-blue-500/30">Web Hosting & Deployment</span>
        </div>
      </div>

      <div class="bg-gray-900/50 backdrop-blur-sm rounded-xl p-8 border border-gray-800 hover:border-blue-500/50 transition-all duration-300 md:col-span-2 lg:col-span-1">
        <div class="text-4xl mb-4">⚙️</div>
  <h3 class="text-2xl font-bold mb-6 text-white">{t?.skills?.infra ?? 'Infrastructure & DevOps'}</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-blue-600/20 text-blue-300 rounded-full text-sm border border-blue-500/30">Server Setup & Configuration</span>
          <span class="px-3 py-1 bg-blue-600/20 text-blue-300 rounded-full text-sm border border-blue-500/30">Cloud Hosting Solutions</span>
          <span class="px-3 py-1 bg-blue-600/20 text-blue-300 rounded-full text-sm border border-blue-500/30">CI/CD Pipelines</span>
          <span class="px-3 py-1 bg-blue-600/20 text-blue-300 rounded-full text-sm border border-blue-500/30">Domain & SSL Management</span>
        </div>
      </div>
    </div>
  </div>
</section>
