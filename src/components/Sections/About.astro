---
const { t } = Astro.props;
---
<div class="h-[80vh] bg-cover bg-center bg-no-repeat relative" style="background-image: url('/imgs/earth.png')">
  <div class="absolute bottom-8 left-0 right-0 lg:bottom-8 bottom-4 flex items-end justify-center h-full lg:h-auto">
    <div class="container mx-auto px-6">
      <div class="flex flex-col lg:flex-row items-center justify-center gap-6 lg:gap-12">
        <div class="flex-shrink-0">
          <div class="relative">
            <img src="/imgs/me.png" alt="Bence Szilagyi" 
                 class="w-48 h-48 lg:w-80 lg:h-80 object-cover rounded-full border-4 border-blue-500/30 shadow-2xl" />
            <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-blue-500/20 to-cyan-400/20"></div>
          </div>
        </div>
        <div class="flex-1 text-center lg:text-left max-w-2xl">
          <h2 class="text-3xl md:text-5xl lg:text-6xl font-bold mb-4 lg:mb-6">
            {t?.about?.titlePrefix ?? "I'm"} <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-400">Bence Szilagyi</span>
          </h2>
          <div class="space-y-2 lg:space-y-4 text-lg lg:text-xl text-gray-300 mb-4 lg:mb-8">
            <p set:html={(t?.about?.ageCountry ?? '{age} years old • Hungary').replace('{age}', '<span id="age-display">20</span>')}></p>
            <p>{t?.about?.passion ?? 'Passionate developer ready to learn and evolve'}</p>
          </div>
          <div class="flex flex-wrap gap-4 justify-center lg:justify-start">
            <a href="#projects" 
               class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-all duration-300 transform hover:scale-105">
              {t?.about?.viewProjects ?? 'View Projects'}
            </a>
            <a href="#contact" 
               class="px-8 py-3 border border-gray-600 hover:border-gray-400 text-gray-300 hover:text-white rounded-lg font-medium transition-all duration-300">
              {t?.about?.contactMe ?? 'Contact Me'}
            </a>
                        <div class="relative group">
              <button id="resume-dropdown-btn" 
                     class="px-8 py-3 border border-gray-600 hover:border-gray-400 text-gray-300 hover:text-white rounded-lg font-medium transition-all duration-300 flex items-center gap-2">
                {t?.about?.downloadCV ?? 'Download CV'}
                <i class="fa-solid fa-chevron-down text-sm transition-transform group-hover:rotate-180"></i>
              </button>
              <div id="resume-dropdown" class="absolute top-full mt-2 left-0 w-full min-w-max bg-gray-800 border border-gray-600 rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                <a href="/Resume - English.pdf" target="_blank" 
                   class="block px-4 py-3 text-gray-300 hover:text-white hover:bg-gray-700 transition-colors rounded-t-lg whitespace-nowrap">
                  <i class="fa-solid fa-file-pdf text-red-400 mr-2"></i>{t?.common?.resumeEnglish ?? 'English Resume'}
                </a>
                <a href="/Resume - Hungarian.pdf" target="_blank" 
                   class="block px-4 py-3 text-gray-300 hover:text-white hover:bg-gray-700 transition-colors rounded-b-lg whitespace-nowrap">
                  <i class="fa-solid fa-file-pdf text-red-400 mr-2"></i>{t?.common?.resumeHungarian ?? 'Hungarian Resume'}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const dropdownBtn = document.getElementById('resume-dropdown-btn');
    const dropdown = document.getElementById('resume-dropdown');
    let isOpen = false;

    if (dropdownBtn && dropdown) {
      dropdownBtn.addEventListener('click', function(e) {
        e.preventDefault();
        isOpen = !isOpen;
        
        if (isOpen) {
          dropdown.classList.remove('opacity-0', 'invisible');
          dropdown.classList.add('opacity-100', 'visible');
        } else {
          dropdown.classList.add('opacity-0', 'invisible');
          dropdown.classList.remove('opacity-100', 'visible');
        }
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', function(e) {
        if (!dropdownBtn.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
          isOpen = false;
          dropdown.classList.add('opacity-0', 'invisible');
          dropdown.classList.remove('opacity-100', 'visible');
        }
      });

      // Close dropdown on escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && isOpen) {
          isOpen = false;
          dropdown.classList.add('opacity-0', 'invisible');
          dropdown.classList.remove('opacity-100', 'visible');
        }
      });
    }
  });
</script>
