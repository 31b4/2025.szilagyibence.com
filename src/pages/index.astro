---
import MainLayout from "../layouts/MainLayout.astro";
import LoadingOverlay from "../components/LoadingOverlay.astro";
import StarsBackground from "../components/StarsBackground.astro";
import NavBar from "../components/NavBar.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Sections/Projects.astro";
import About from "../components/Sections/About.astro";
import Achievements from "../components/Sections/Achievements.astro";
import Skills from "../components/Sections/Skills.astro";
import Contact from "../components/Sections/Contact.astro";
import Footer from "../components/Footer.astro";
const pageTitle = "Bence Szilagyi | Developer & Creator | Hungary";
---

<MainLayout title={pageTitle}>
  <fragment slot="head">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Bence Szilagyi - Developer & creator with a passion for thoughtfully constructed, timeless solutions. Explore my projects, connect on social media, and discover my work in development and innovation." />
    <meta name="keywords" content="Szilagyi Bence, Bence Szilagyi, Szilágyi Bence, Bence Szilágyi, developer, software developer, web developer, personal website, portfolio, 31b4, kki, innovation, Hungary, tech, projects, GitHub, Bence, 4d, typex, meridian, starlink, pi, leetcode, advent of code, bbb, gamf, univerx, trackit, pte kki calculator" />
    <meta name="author" content="Szilagyi Bence" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.szilagyibence.com/" />
    <meta property="og:title" content="Bence Szilagyi | Developer & Creator" />
    <meta property="og:description" content="Passionate developer from Hungary showcasing innovative projects and achievements" />
    <meta property="og:image" content="https://www.szilagyibence.com/imgs/projects/trackit.png" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://www.szilagyibence.com/" />
    <meta property="twitter:title" content="Bence Szilagyi | Developer & Creator" />
    <meta property="twitter:description" content="Passionate developer from Hungary showcasing innovative projects and achievements" />
    <meta property="twitter:image" content="https://www.szilagyibence.com/imgs/projects/trackit.png" />
    <meta name="twitter:creator" content="@31b4_" />
    <link rel="canonical" href="https://www.szilagyibence.com/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Szilagyi Bence",
        alternateName: "Bence Szilagyi",
        url: "https://www.szilagyibence.com/",
        email: "contact@szilagyibence.com",
        image: "https://www.szilagyibence.com/imgs/projects/trackit.png",
        sameAs: [
          "https://twitter.com/31b4_",
          "https://github.com/31b4",
          "https://linkedin.com/in/benszilagyi/"
        ],
        jobTitle: "Developer",
        worksFor: { "@type": "Organization", name: "Independent" },
        address: { "@type": "PostalAddress", addressCountry: "Hungary" }
      })}
    </script>
  </fragment>

  <LoadingOverlay />
  <StarsBackground />
  <NavBar />
  <Hero />

  <div class="h-[92vh]"></div>

  <div class="relative z-40">
    <About />
    <Projects />
  </div>

  <Achievements />
  <Skills />
  <Contact />
  <Footer />

  <script is:inline src="/js/home.js"></script>
</MainLayout>
