---
import MainLayout from "../layouts/MainLayout.astro";
import StarsBackground from "../components/StarsBackground.astro";
import NavBar from "../components/NavBar.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Sections/Projects.astro";
import About from "../components/Sections/About.astro";
import WorkExperience from "../components/Sections/WorkExperience.astro";
import Achievements from "../components/Sections/Achievements.astro";
import Skills from "../components/Sections/Skills.astro";
import Contact from "../components/Sections/Contact.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette.astro";
import GitHubActivity from "../components/GitHubActivity.astro";
import { loadDictionary } from "../i18n";

const locale = 'en';
const t = await loadDictionary(locale);
const pageTitle = t.meta?.title ?? "Bence Szilagyi | Developer & Creator | Hungary";
---
<MainLayout title={pageTitle} lang="en">
  <fragment slot="head">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={t.meta?.description} />
    <meta name="keywords" content="Szilagyi Bence, Bence Szilagyi, Szilágyi Bence, Bence Szilágyi, developer, software developer, web developer, personal website, portfolio, 31b4, kki, innovation, Hungary, tech, projects, GitHub, Bence, 4d, typex, meridian, starlink, pi, leetcode, advent of code, bbb, gamf, univerx, trackit, pte kki calculator" />
    <meta name="author" content="Szilagyi Bence" />
  	<meta property="og:type" content="website" />
    <meta property="og:url" content="https://szilagyibence.com/" />
    <meta property="og:title" content={t.meta?.ogTitle} />
    <meta property="og:description" content={t.meta?.ogDescription} />
    <meta property="og:image" content="https://szilagyibence.com/imgs/me.png" />
	<meta property="og:site_name" content="Bence Szilagyi" />
	<meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://szilagyibence.com/" />
	<meta name="twitter:title" content={t.meta?.ogTitle} />
	<meta name="twitter:description" content={t.meta?.ogDescription} />
    <meta name="twitter:image" content="https://szilagyibence.com/imgs/projects/trackit.png" />
    <meta name="twitter:creator" content="@31b4_" />
  	<meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://szilagyibence.com/" />
    <link rel="alternate" hreflang="en" href="https://szilagyibence.com/" />
    <link rel="alternate" hreflang="hu" href="https://szilagyibence.com/hu/" />
    <link rel="alternate" hreflang="es" href="https://szilagyibence.com/es/" />
  <link rel="alternate" hreflang="zh" href="https://szilagyibence.com/zh/" />
  <link rel="alternate" hreflang="ja" href="https://szilagyibence.com/ja/" />
  <link rel="alternate" hreflang="hi" href="https://szilagyibence.com/hi/" />
  <link rel="alternate" hreflang="fr" href="https://szilagyibence.com/fr/" />
  <link rel="alternate" hreflang="ar" href="https://szilagyibence.com/ar/" />
  <link rel="alternate" hreflang="ru" href="https://szilagyibence.com/ru/" />
  <link rel="alternate" hreflang="pt" href="https://szilagyibence.com/pt/" />
  <link rel="alternate" hreflang="id" href="https://szilagyibence.com/id/" />
  <link rel="alternate" hreflang="x-default" href="https://szilagyibence.com/" />
  <!-- Non-standard pseudo-locale for debugging -->
  <link rel="alternate" hreflang="x-ascii" href="https://szilagyibence.com/ascii/" />
  <link rel="alternate" hreflang="x-morse" href="https://szilagyibence.com/morse/" />
  <link rel="alternate" hreflang="x-binary" href="https://szilagyibence.com/binary/" />
  <link rel="alternate" hreflang="x-hex" href="https://szilagyibence.com/hex/" />
  <link rel="alternate" hreflang="x-hier" href="https://szilagyibence.com/hier/" />
  <link rel="alternate" hreflang="x-braille" href="https://szilagyibence.com/braille/" />
  <link rel="alternate" hreflang="x-asl" href="https://szilagyibence.com/asl/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function(){
  var supported = ['en','hu','es','zh','ja','hi','fr','ar','ru','pt','id'];
        var langs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en']).map(function(l){return l.toLowerCase();});
        var pick = 'en';
        for (var i=0;i<langs.length;i++) {
          var base = langs[i].split('-')[0];
          if (supported.indexOf(base) !== -1) { pick = base; break; }
        }
        if (pick !== 'en' && (location.pathname === '/' || /^\/index\.html$/.test(location.pathname))) {
          location.replace('/' + pick + '/');
        }
      })();
    </script>
  </fragment>

  <h1 class="sr-only">Bence Szilagyi — Developer & Creator from Hungary</h1>

  <CommandPalette />
  <StarsBackground />
  <NavBar t={t} lang={locale} />
  <Hero t={t} />

  <div class="h-[92vh]"></div>

  <div class="relative z-40">
    <About t={t} />
    <Projects t={t} />
    <WorkExperience t={t} />
  </div>

  <Achievements t={t} />
  <Skills t={t} />
  <GitHubActivity />
  <Contact t={t} />
  <Footer t={t} />

  <script is:inline src="/js/home.js"></script>
</MainLayout>
